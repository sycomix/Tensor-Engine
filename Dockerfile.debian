# Dockerfile for Debian-based build of Tensor-Engine
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    libssl-dev \
    libopenblas-dev \
    patchelf \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin
RUN pip install --break-system-packages maturin

WORKDIR /app

# Copy the entire repository
COPY . .

# Setup virtual environment
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Build and install the Python bindings with all features
RUN pip install --upgrade pip maturin && \
    maturin develop --release -F python_bindings,openblas,multi_precision,safe_tensors,with_tokenizers,vision,audio,parallel_io,server,backend_wgpu,quantized,dtype_f16,dtype_bf16

# Default command
CMD ["bash"]
